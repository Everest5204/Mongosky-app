      "before": [
        "    val isSignupPage = route == MainRoute.SIGNUP\n"
      ],
      "after": "    val isSignupPage = route == MainRoute.SIGNUP\n    val isSettingsPage = route == MainRoute.SETTINGS\n"
    },
    {
      "name": "Settings drawer visibility",
      "before": [
        "    val drawerVisible = !isInformationPage && !isSignupPage && (drawerState.isOpen || drawerState.targetValue == DrawerValue.Open)",
        "    val drawerVisible = !isSignupPage && (drawerState.isOpen || drawerState.targetValue == DrawerValue.Open)"
      ],
      "mode": "drawer-prefix",
      "after": "    val drawerVisible = !isSettingsPage && "
    },
    {
      "name": "Settings drawer opening",
      "before": [
        "        val target = destination.routeName?.let(MainRoute::valueOf) ?: return\n"
      ],
      "after": "        val target = destination.routeName?.let(MainRoute::valueOf) ?: return\n        if (target == MainRoute.SETTINGS) {\n            if (signingOut || mediaPickerOpen || signupOpening.isOpening) return\n            feedViewModel.closeOverlays()\n            createMenuOpen = false\n            backStack = SettingsNavigation.push(backStack)\n            scope.launch { drawerState.snapTo(DrawerValue.Closed) }\n            return\n        }\n"
    },
    {
      "name": "Settings full-screen host",
      "before": [
        "                if (isInformationPage) {",
        "                if (route == MainRoute.CHANGE_NAME) {",
        "                if (isSignupPage) {"
      ],
      "after": "                if (isSettingsPage) {\n                    contentState.SaveableStateProvider(entry) {\n                        SettingsRoute(onBack = {\n                            if (!signingOut) backStack = SettingsNavigation.back(backStack, entry)\n                        })\n                    }\n                } else ",
      "mode": "prefix-first"
    }
